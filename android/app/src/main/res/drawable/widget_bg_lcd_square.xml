    </item>
    <item android:left="10dp" android:top="10dp" android:right="10dp" android:bottom="14dp">
        <shape><solid android:color="#FF4A4A58" />
            <corners android:topLeftRadius="8dp" android:topRightRadius="8dp" android:bottomLeftRadius="8dp" android:bottomRightRadius="26dp" /></shape>
    </item>
    <item android:left="20dp" android:top="26dp" android:right="20dp" android:bottom="24dp">
        <shape><solid android:color="#FF9BBC0F" /><corners android:radius="3dp" /></shape>
    </item>
