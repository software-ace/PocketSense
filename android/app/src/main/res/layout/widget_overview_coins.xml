<?xml version="1.0" encoding="utf-8"?>
<!-- Overview, Coin nap. The text is drawn into the slots by
     BalanceWidgets.kt: widgets can't use an app's fonts. Generated by android/tools/widget_layouts.py. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_coins">
    <FrameLayout android:id="@+id/widget_awake" android:layout_width="match_parent" android:layout_height="match_parent">
        <ImageView android:layout_width="40dp" android:layout_height="36dp" android:layout_gravity="bottom|end" android:layout_marginBottom="14dp" android:layout_marginEnd="18dp" android:scaleType="fitXY" android:importantForAccessibility="no" android:src="@drawable/widget_stack_coins" />
        <ImageView android:layout_width="48dp" android:layout_height="30dp" android:layout_gravity="bottom|end" android:layout_marginBottom="46dp" android:layout_marginEnd="14dp" android:scaleType="fitXY" android:importantForAccessibility="no" android:src="@drawable/widget_cat_coins_awake" />
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="bottom|end" android:layout_marginBottom="14dp" android:layout_marginEnd="64dp" android:scaleType="fitXY" android:importantForAccessibility="no" android:src="@drawable/widget_coin_coins" />
    </FrameLayout>
    <FrameLayout android:id="@+id/widget_asleep" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="bottom|end" android:layout_marginBottom="14dp" android:layout_marginEnd="52dp" android:scaleType="fitXY" android:importantForAccessibility="no" android:src="@drawable/widget_coin_coins" />
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="bottom|end" android:layout_marginBottom="14dp" android:layout_marginEnd="34dp" android:scaleType="fitXY" android:importantForAccessibility="no" android:src="@drawable/widget_coin_coins" />
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="bottom|end" android:layout_marginBottom="14dp" android:layout_marginEnd="16dp" android:scaleType="fitXY" android:importantForAccessibility="no" android:src="@drawable/widget_coin_coins" />
        <ImageView android:layout_width="60dp" android:layout_height="38dp" android:layout_gravity="bottom|end" android:layout_marginBottom="28dp" android:layout_marginEnd="12dp" android:scaleType="fitXY" android:importantForAccessibility="no" android:src="@drawable/widget_cat_coins_asleep" />
        <ImageView android:layout_width="20dp" android:layout_height="11dp" android:layout_gravity="bottom|end" android:layout_marginBottom="70dp" android:layout_marginEnd="16dp" android:scaleType="fitXY" android:importantForAccessibility="no" android:src="@drawable/widget_zz_coins" />
    </FrameLayout>
    <ImageView android:id="@+id/widget_brand" android:layout_width="wrap_content" android:layout_height="8dp" android:layout_gravity="top|start"  android:adjustViewBounds="true" android:scaleType="centerInside" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="18dp">
        <ImageView android:id="@+id/widget_label" android:layout_width="wrap_content" android:layout_height="13dp" android:layout_gravity="start"  android:adjustViewBounds="true" android:scaleType="centerInside" android:visibility="gone" />
        <ImageView android:id="@+id/widget_amount" android:layout_width="wrap_content" android:layout_height="28dp" android:layout_gravity="start" android:layout_marginTop="2dp" android:adjustViewBounds="true" android:scaleType="centerInside" android:visibility="gone" />
        <ImageView android:id="@+id/widget_label2" android:layout_width="wrap_content" android:layout_height="13dp" android:layout_gravity="start" android:layout_marginTop="8dp" android:adjustViewBounds="true" android:scaleType="centerInside" android:visibility="gone" />
        <ImageView android:id="@+id/widget_amount2" android:layout_width="wrap_content" android:layout_height="22dp" android:layout_gravity="start" android:layout_marginTop="2dp" android:adjustViewBounds="true" android:scaleType="centerInside" android:visibility="gone" />
        <ImageView android:id="@+id/widget_hint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="start" android:layout_marginTop="6dp" android:adjustViewBounds="true" android:scaleType="centerInside" android:visibility="gone" />
    </LinearLayout>
    <ImageView android:id="@+id/widget_stamp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"  android:adjustViewBounds="true" android:scaleType="centerInside" android:visibility="gone" />
</FrameLayout>
