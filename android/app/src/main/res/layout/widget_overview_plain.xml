<?xml version="1.0" encoding="utf-8"?>
<!-- Overview, Plain. The text is drawn into the slots by
     BalanceWidgets.kt: widgets can't use an app's fonts. Generated by android/tools/widget_layouts.py. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/quick_add_widget_bg">
    <FrameLayout android:id="@+id/widget_awake" android:layout_width="match_parent" android:layout_height="match_parent">
        
    </FrameLayout>
    <FrameLayout android:id="@+id/widget_asleep" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
        
    </FrameLayout>
    <ImageView android:id="@+id/widget_brand" android:layout_width="wrap_content" android:layout_height="8dp" android:layout_gravity="top|start"  android:adjustViewBounds="true" android:scaleType="centerInside" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_label" android:layout_width="match_parent" android:layout_height="wrap_content"  android:maxLines="1" android:ellipsize="end" android:textAlignment="viewStart" android:textColor="@color/balance_widget_muted" android:textSize="12sp" android:visibility="gone" />
        <TextView android:id="@+id/widget_amount" android:layout_width="match_parent" android:layout_height="28dp"  android:maxLines="1" android:ellipsize="end" android:textAlignment="viewStart" android:textColor="@color/balance_widget_fg" android:textSize="20sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="20sp" android:textStyle="bold" android:visibility="gone" />
        <TextView android:id="@+id/widget_label2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:maxLines="1" android:ellipsize="end" android:textAlignment="viewStart" android:textColor="@color/balance_widget_muted" android:textSize="12sp" android:visibility="gone" />
        <TextView android:id="@+id/widget_amount2" android:layout_width="match_parent" android:layout_height="24dp"  android:maxLines="1" android:ellipsize="end" android:textAlignment="viewStart" android:textColor="@color/balance_widget_fg" android:textSize="16sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="16sp" android:textStyle="bold" android:visibility="gone" />
        <TextView android:id="@+id/widget_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:maxLines="2" android:ellipsize="end" android:textAlignment="viewStart" android:textColor="@color/balance_widget_muted" android:textSize="11sp" android:visibility="gone" />
    </LinearLayout>
    <ImageView android:id="@+id/widget_stamp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"  android:adjustViewBounds="true" android:scaleType="centerInside" android:visibility="gone" />
</FrameLayout>
