<?xml version="1.0" encoding="utf-8"?>
<!-- Account, Pocket LCD. The text is drawn into the slots by
     BalanceWidgets.kt: widgets can't use an app's fonts. Generated by android/tools/widget_layouts.py. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_lcd_wide">
    <FrameLayout android:id="@+id/widget_awake" android:layout_width="match_parent" android:layout_height="match_parent">
        <ImageView android:layout_width="30dp" android:layout_height="19dp" android:layout_gravity="top|end" android:layout_marginTop="20dp" android:layout_marginEnd="24dp" android:scaleType="fitXY" android:importantForAccessibility="no" android:src="@drawable/widget_cat_lcd_awake" />
    </FrameLayout>
    <FrameLayout android:id="@+id/widget_asleep" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
        <ImageView android:layout_width="30dp" android:layout_height="19dp" android:layout_gravity="top|end" android:layout_marginTop="20dp" android:layout_marginEnd="24dp" android:scaleType="fitXY" android:importantForAccessibility="no" android:src="@drawable/widget_cat_lcd_asleep" />
        <ImageView android:layout_width="12dp" android:layout_height="7dp" android:layout_gravity="top|end" android:layout_marginTop="16dp" android:layout_marginEnd="56dp" android:scaleType="fitXY" android:importantForAccessibility="no" android:src="@drawable/widget_zz_lcd" />
    </FrameLayout>
    <ImageView android:id="@+id/widget_brand" android:layout_width="wrap_content" android:layout_height="8dp" android:layout_gravity="top|start"  android:adjustViewBounds="true" android:scaleType="centerInside" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="26dp" android:paddingEnd="26dp" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_label" android:layout_width="wrap_content" android:layout_height="14dp" android:layout_gravity="start" android:layout_marginEnd="36dp" android:adjustViewBounds="true" android:scaleType="centerInside" android:visibility="gone" />
        <ImageView android:id="@+id/widget_amount" android:layout_width="wrap_content" android:layout_height="24dp" android:layout_gravity="start" android:layout_marginTop="4dp" android:adjustViewBounds="true" android:scaleType="centerInside" android:visibility="gone" />
        <ImageView android:id="@+id/widget_label2" android:layout_width="wrap_content" android:layout_height="12dp" android:layout_gravity="start"  android:adjustViewBounds="true" android:scaleType="centerInside" android:visibility="gone" />
        <ImageView android:id="@+id/widget_amount2" android:layout_width="wrap_content" android:layout_height="12dp" android:layout_gravity="start"  android:adjustViewBounds="true" android:scaleType="centerInside" android:visibility="gone" />
        <ImageView android:id="@+id/widget_hint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="start"  android:adjustViewBounds="true" android:scaleType="centerInside" android:visibility="gone" />
    </LinearLayout>
    <ImageView android:id="@+id/widget_stamp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"  android:adjustViewBounds="true" android:scaleType="centerInside" android:visibility="gone" />
</FrameLayout>
