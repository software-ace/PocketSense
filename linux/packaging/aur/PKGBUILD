# Maintainer: software-ace <a.abuyahia@protonmail.com>
# Repackages the release .deb, so the files and paths match the .deb/.rpm
# (linux/packaging/nfpm.yaml). Bump pkgver and sha256sums each release.
pkgname=pocket-sense-bin
pkgver=2.4.2
pkgrel=1
pkgdesc='Offline, encrypted personal finance tracker, in English and Arabic'
arch=('x86_64')
url='https://github.com/software-ace/PocketSense'
license=('GPL-3.0-or-later')
depends=('gtk3' 'libsecret' 'sqlite' 'libglvnd' 'glib2' 'glibc' 'gcc-libs')
optdepends=('libpulse: parecord, for voice entry'
            'org.freedesktop.secrets: keyring to hold the database key (GNOME Keyring or KWallet)')
provides=('pocket-sense')
conflicts=('pocket-sense')
# Prebuilt Flutter engine and Dart AOT snapshot: stripping can break them.
options=('!strip' '!debug')
source=("$url/releases/download/v$pkgver/PocketSense-v$pkgver-linux-x64.deb")
sha256sums=('a838e5a8b5716168cf97358be512a373ce4c895b1214ebe0d065ca0da459a20c')

package() {
  bsdtar -xf data.tar.gz -C "$pkgdir"
}
